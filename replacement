const cart = [];
function createCartObject(prod) {
  const cartProduct = { ...prod, quantity: 1 };
  return cartProduct;
  }
  function checkCart(prod) {
  const cartProduct = { ...prod, quantity: 1 };
  const found = cart.find((cartItem) => cartItem.title === prod.title);
  if (found) {
    found.quantity += 1;
  } else {
    cart.push(prod);
  }
}
